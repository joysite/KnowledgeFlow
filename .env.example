
# ==========================================
# KnowledgeFlow 环境变量配置示例
# ==========================================

# 应用配置
KLF_APP_NAME=KnowledgeFlow
KLF_APP_VERSION=0.1.0
KLF_DEBUG=false

# API 服务配置
KLF_HOST=127.0.0.1
KLF_PORT=8000
KLF_API_PREFIX=/api/v1

# 日志配置
KLF_LOG_LEVEL=INFO
KLF_LOG_FILE=knowledgeflow.log
KLF_LOG_MAX_BYTES=10485760
KLF_LOG_BACKUP_COUNT=5

# Ollama 与 Embedding 配置
KLF_OLLAMA_BASE_URL=http://localhost:11434
KLF_EMBEDDING_MODEL=nomic-embed-text:latest
KLF_EMBEDDING_TIMEOUT_SECONDS=60
# Ollama 对话生成配置
KLF_CHAT_MODEL=qwen2.5-coder:7b
KLF_CHAT_TIMEOUT_SECONDS=180

# 文档上传配置
KLF_MAX_UPLOAD_SIZE_BYTES=20971520

# PDF 解析资源限制
KLF_PDF_MAX_PAGES=500
KLF_PDF_MAX_PAGE_CHARS=200000
KLF_PDF_MAX_TOTAL_CHARS=2000000

